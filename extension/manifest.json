{
  "manifest_version": 3,
  "name": "Shadow AI Policy Guard",
  "version": "1.0.0",
  "description": "Inspects prompts before they are submitted to supported AI chat sites.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*","http://localhost:8000/*","https://chatgpt.com/*","https://chat.openai.com/*","https://claude.ai/*"],
  "content_scripts": [{"matches":["https://chatgpt.com/*","https://chat.openai.com/*","https://claude.ai/*"],"js":["content.js"],"run_at":"document_idle"}]
}
